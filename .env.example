OPENFOX_ENV=development
OPENFOX_SERVER_LISTEN=127.0.0.1:8080
OPENFOX_SERVER_PUBLIC_URL=http://127.0.0.1:8080
OPENFOX_DATABASE_URL_FILE=
OPENFOX_DATABASE_POOL_MAX=20
OPENFOX_DATABASE_CONTEXT_ROLE=openfox_context
OPENFOX_DATABASE_APP_ROLE=openfox_app
OPENFOX_DATABASE_STATEMENT_TIMEOUT=3s
OPENFOX_DATABASE_LOCK_TIMEOUT=1s
OPENFOX_AUTH_ARGON2_MEMORY_KIB=65536
OPENFOX_AUTH_ARGON2_ITERATIONS=3
OPENFOX_AUTH_ARGON2_PARALLELISM=1
OPENFOX_AUTH_ARGON2_KEY_LENGTH=32
OPENFOX_AUTH_SESSION_IDLE=12h
OPENFOX_AUTH_SESSION_ABSOLUTE=168h
OPENFOX_SCHEDULER_OFFER_TTL=15s
OPENFOX_SCHEDULER_POLL_INTERVAL=1s
OPENFOX_SCHEDULER_BATCH=50
OPENFOX_RUN_LEASE_TTL=90s
OPENFOX_RUN_LEASE_RENEW=20s
OPENFOX_STORAGE_ROOT=./var/openfox
# Gitee 集成（阶段 7g-3，可选）：第三方应用的 Client ID 与 Client Secret 文件（绝对路径，权限 0600）；两项同时设置才算已配置。
# 回调地址填 ${OPENFOX_SERVER_PUBLIC_URL}/api/v1/integrations/gitee/callback；地址默认 gitee.com，联调本机模拟服务时改成 http://127.0.0.1:18103。
# OPENFOX_GITEE_CLIENT_ID=
# OPENFOX_GITEE_CLIENT_SECRET_FILE=
# OPENFOX_GITEE_BASE_URL=https://gitee.com
# OPENFOX_GITEE_API_URL=https://gitee.com/api/v5

# Asana（可选）：组织共享 workspace 与个人身份核验使用两个不同 OAuth app。
# 四项同时配置；Secret 文件绝对路径、0600；沿用集成加密密钥及 SERVER_PUBLIC_URL。
# 组织回调 ${OPENFOX_SERVER_PUBLIC_URL}/api/v1/integrations/asana/callback
# 个人回调 ${OPENFOX_SERVER_PUBLIC_URL}/api/v1/integrations/asana/identity/callback
# OPENFOX_ASANA_CLIENT_ID=
# OPENFOX_ASANA_CLIENT_SECRET_FILE=
# OPENFOX_ASANA_IDENTITY_CLIENT_ID=
# OPENFOX_ASANA_IDENTITY_CLIENT_SECRET_FILE=

# Azure DevOps Services: two distinct confidential Entra Web applications.
# Org delegated permissions: vso.profile vso.code vso.threads_full vso.work vso.identity.
# Identity delegated permission: vso.profile only. No Graph or application permissions.
# .default uses these registered permissions; secret files must not be group/world readable.
OPENFOX_AZURE_DEVOPS_ORG_CLIENT_ID=
OPENFOX_AZURE_DEVOPS_ORG_CLIENT_SECRET_FILE=
OPENFOX_AZURE_DEVOPS_IDENTITY_CLIENT_ID=
OPENFOX_AZURE_DEVOPS_IDENTITY_CLIENT_SECRET_FILE=

# R05 device daemon only. Unset means unavailable; prepare the pinned build first.
# See tools/hermes/README.md. These are not Agent/R06 environment keys.
OPENFOX_HERMES_ROOT=
OPENFOX_HERMES_PYTHON=

# Bitbucket Cloud: independent organization (account + pullrequest) and personal
# identity (account only) OAuth consumers. Empty pair disables that flow.
# Each secret file must be an absolute, private regular file; never inline secrets.
OPENFOX_BITBUCKET_ORG_CLIENT_ID=
OPENFOX_BITBUCKET_ORG_CLIENT_SECRET_FILE=
OPENFOX_BITBUCKET_PERSONAL_CLIENT_ID=
OPENFOX_BITBUCKET_PERSONAL_CLIENT_SECRET_FILE=

# Slack central App (all empty disables only Slack). Both secret files must be
# absolute paths readable only by the service account; never paste secrets here.
OPENFOX_SLACK_CLIENT_ID=
OPENFOX_SLACK_CLIENT_SECRET_FILE=
OPENFOX_SLACK_SIGNING_SECRET_FILE=

# QQ 扫码：两项同时留空或同时设置绝对路径；空值仅关闭扫码入口。
# 使用核验过的 Node 22.23.1 与官方 qqbot-connector 1.2.0 / qrcode-terminal 0.12.0。
# OpenFox 不自动安装依赖；实际启动前再次核验固定文件，不能填任意插件目录。
OPENFOX_QQ_CONNECTOR_NODE_PATH=
OPENFOX_QQ_CONNECTOR_ROOT=

# R02 device daemon only: fixed official Gemini CLI 0.67.0 and Node 22.23.1.
# Empty discovers existing installations; explicit invalid paths never fall back.
# API key and model belong in Agent/R06 secrets, not these path settings.
OPENFOX_GEMINI_PATH=
OPENFOX_GEMINI_NODE_PATH=

# I06 server only: US Zoho BugTracker REST, separate organization/identity OAuth apps.
# Empty disables new authorization/import; use an absolute regular 0600 JSON file.
# Shape: {"region":"US","organization":{"client_id":"...","client_secret":"..."},
#         "identity":{"client_id":"...","client_secret":"..."}}; app IDs must differ.
# Both apps use ${OPENFOX_SERVER_PUBLIC_URL}/api/v1/integrations/zoho_bugtracker/callback.
# Never paste real client secrets into this example or the environment variable.
OPENFOX_ZOHO_OAUTH_APPS_FILE=

# Office 原版式预览：隔离的 Gotenberg 服务地址；留空时 Office 仅可下载。
OPENFOX_OFFICE_PREVIEW_URL=http://127.0.0.1:3000
