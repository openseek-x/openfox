OPENFOX_ENV=development
OPENFOX_SERVER_LISTEN=127.0.0.1:8080
OPENFOX_SERVER_PUBLIC_URL=http://127.0.0.1:8080
OPENFOX_DATABASE_URL_FILE=
OPENFOX_DATABASE_POOL_MAX=20
OPENFOX_DATABASE_CONTEXT_ROLE=openfox_context
OPENFOX_DATABASE_APP_ROLE=openfox_app
OPENFOX_DATABASE_STATEMENT_TIMEOUT=3s
OPENFOX_DATABASE_LOCK_TIMEOUT=1s
OPENFOX_AUTH_ARGON2_MEMORY_KIB=65536
OPENFOX_AUTH_ARGON2_ITERATIONS=3
OPENFOX_AUTH_ARGON2_PARALLELISM=1
OPENFOX_AUTH_ARGON2_KEY_LENGTH=32
OPENFOX_AUTH_SESSION_IDLE=12h
OPENFOX_AUTH_SESSION_ABSOLUTE=168h
OPENFOX_SCHEDULER_OFFER_TTL=15s
OPENFOX_SCHEDULER_POLL_INTERVAL=1s
OPENFOX_SCHEDULER_BATCH=50
OPENFOX_RUN_LEASE_TTL=90s
OPENFOX_RUN_LEASE_RENEW=20s
OPENFOX_STORAGE_ROOT=./var/openfox
# Gitee 集成（阶段 7g-3，可选）：第三方应用的 Client ID 与 Client Secret 文件（绝对路径，权限 0600）；两项同时设置才算已配置。
# 回调地址填 ${OPENFOX_SERVER_PUBLIC_URL}/api/v1/integrations/gitee/callback；地址默认 gitee.com，联调本机模拟服务时改成 http://127.0.0.1:18103。
# OPENFOX_GITEE_CLIENT_ID=
# OPENFOX_GITEE_CLIENT_SECRET_FILE=
# OPENFOX_GITEE_BASE_URL=https://gitee.com
# OPENFOX_GITEE_API_URL=https://gitee.com/api/v5
