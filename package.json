{
  "name": "openfox-workbench",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=22.22.2 <23",
    "pnpm": "11.15.1"
  },
  "scripts": {
    "dev": "pnpm --filter @openfox/web dev",
    "build": "pnpm --filter @openfox/web build",
    "desktop": "pnpm --filter @openfox/web build && pnpm --filter @openfox/desktop start",
    "desktop:build": "pnpm --filter @openfox/web build",
    "test": "vitest run && pnpm --filter @openfox/desktop test",
    "test:workspace:electron": "node --test tests/frontend/workspace-storage.electron.test.cjs",
    "test:e2e": "pnpm build && playwright test",
    "typecheck": "pnpm -r typecheck && tsc -p tests/frontend/tsconfig.json",
    "format": "prettier --write apps packages tests/frontend *.json *.yaml *.ts",
    "lint": "prettier --check apps packages tests/frontend *.json *.yaml *.ts eslint.config.mjs tests/contracts/*.mjs && eslint apps packages && pnpm typecheck",
    "check": "pnpm check:api && pnpm lint && pnpm test && pnpm build",
    "gen:api": "openapi-typescript contracts/openapi.yaml -o packages/api/src/schema.gen.ts",
    "check:api": "node tests/contracts/check-api.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/parser": "8.74.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "6.2.8",
    "jsdom": "30.1.3",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "vitest": "5.0.5",
    "yaml": "2.9.1"
  }
}
