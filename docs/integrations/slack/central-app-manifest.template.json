{
  "display_information": {
    "name": "OpenFox",
    "description": "OpenFox notifications and task links"
  },
  "features": {
    "bot_user": {
      "display_name": "OpenFox",
      "always_online": false
    },
    "app_home": {
      "home_tab_enabled": false,
      "messages_tab_enabled": true,
      "messages_tab_read_only_enabled": false
    },
    "unfurl_domains": ["openfox.example.com"]
  },
  "oauth_config": {
    "redirect_urls": [
      "https://openfox.example.com/api/v1/integrations/slack/callback",
      "https://openfox.example.com/api/v1/integrations/slack/identity/callback"
    ],
    "scopes": {
      "bot": [
        "chat:write",
        "im:write",
        "im:read",
        "im:history",
        "users:read",
        "links:read",
        "links:write",
        "channels:read",
        "groups:read"
      ]
    }
  },
  "settings": {
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "token_rotation_enabled": true,
    "event_subscriptions": {
      "request_url": "https://openfox.example.com/api/v1/integrations/slack/events/central",
      "bot_events": ["link_shared", "message.im", "app_uninstalled", "tokens_revoked"]
    }
  }
}
